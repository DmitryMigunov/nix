{
  "layer": "top",
  "position": "top",
  "height": 26,

  "group/left": {
    "orientation": "horizontal",
    "modules": ["sway/workspaces", "sway/window"],
  },

  "group/right": {
    "orientation": "horizontal",
    "modules": ["custom/kube", "network", "pulseaudio", "clock", "tray"],
  },

  "modules-left": ["group/left"],
  "modules-center": [],
  "modules-right": ["group/right"],

  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "format": "{name}",
  },

  "sway/window": {
    "format": "{}",
    "max-length": 150,
  },

  "network": {
    "format-wifi": "  {ipaddr}",
    "format-ethernet": "󰈀 {ipaddr}",
    "format-disconnected": "󰲜 No IP",
    "tooltip-format": "{ifname} via {gwaddr}",
  },

  "clock": {
    "format": "{:%Y-%m-%d %H:%M:%S %Z}",
    "interval": 1,
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
  },

  "tray": {
    "icon-size": 15,
    "spacing": 10,
  },

  "custom/kube": {
    "exec": "lua ~/.config/waybar/kube-context.lua",
    "return-type": "json",
    "interval": 3,
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "{icon} {volume}%",
    "format-muted": "󰝟 {volume}%",
    "format-icons": {
      "headphone": "󰋎",
      "hands-free": "󰂑",
      "headset": "󰋎",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    },
    "scroll-step": 2,
    "on-click": "pavucontrol",
    "tooltip-format": "{desc} | {volume}%"
  },
}
